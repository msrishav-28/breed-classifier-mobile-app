<?xml version="1.0" encoding="utf-8"?>
<!-- Photos and classification history stay on the device: they can be large
     and may be considered sensitive farm data. -->
<full-backup-content>
    <exclude domain="database" path="classifications.db" />
    <exclude domain="file" path="images/" />
    <exclude domain="file" path="reports/" />
</full-backup-content>
