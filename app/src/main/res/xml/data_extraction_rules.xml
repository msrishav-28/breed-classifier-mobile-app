<?xml version="1.0" encoding="utf-8"?>
<!-- Mirrors backup_rules.xml for Android 12+ cloud backup and device
     transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="classifications.db" />
        <exclude domain="file" path="images/" />
        <exclude domain="file" path="reports/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="classifications.db" />
        <exclude domain="file" path="images/" />
        <exclude domain="file" path="reports/" />
    </device-transfer>
</data-extraction-rules>
