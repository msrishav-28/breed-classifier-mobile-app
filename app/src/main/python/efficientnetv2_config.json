{
  "model": {
    "name": "efficientnetv2_s",
    "pretrained": true,
    "dropout_rate": 0.2,
    "drop_path_rate": 0.2,
    "input_size": 384,
    "freeze_backbone_epochs": 3,
    "use_ema": true,
    "ema_decay": 0.9999
  },
  "training": {
    "batch_size": 12,
    "val_batch_size": 24,
    "epochs": 40,
    "learning_rate": 1e-3,
    "backbone_lr": 1e-4,
    "weight_decay": 1e-5,
    "warmup_epochs": 3,
    "gradient_accumulation_steps": 2,
    "max_grad_norm": 1.0,
    "early_stopping_patience": 8,
    "label_smoothing": 0.1,
    "mixup_alpha": 0.2,
    "cutmix_alpha": 1.0,
    "mixup_prob": 0.5,
    "cutmix_prob": 0.5
  },
  "optimization": {
    "mixed_precision": true,
    "optimizer": "adamw",
    "scheduler": "cosine_restarts",
    "scheduler_params": {
      "T_0": 10,
      "T_mult": 2,
      "eta_min": 1e-6
    },
    "gradient_checkpointing": true
  },
  "data": {
    "num_workers": 2,
    "pin_memory": true,
    "persistent_workers": false,
    "validation_split": 0.2,
    "augmentation_strength": "strong",
    "cache_dataset": false
  },
  "augmentation": {
    "rotation_limit": 20,
    "shift_limit": 0.1,
    "scale_limit": 0.3,
    "brightness_limit": 0.3,
    "contrast_limit": 0.3,
    "hue_shift_limit": 25,
    "sat_shift_limit": 35,
    "val_shift_limit": 25,
    "noise_probability": 0.3,
    "blur_probability": 0.2,
    "dropout_probability": 0.4,
    "cutout_probability": 0.3
  },
  "targets": {
    "accuracy_target": 88.0,
    "accuracy_range": [88.0, 91.0],
    "ensemble_contribution": "tertiary",
    "inference_time_ms": 800,
    "model_size_mb": 30
  },
  "hardware": {
    "device": "cuda",
    "gpu_memory_limit": "16GB",
    "target_platform": "kaggle_p100",
    "memory_efficient": true,
    "compile_model": false
  },
  "logging": {
    "log_level": "INFO",
    "save_checkpoints": true,
    "checkpoint_frequency": 5,
    "save_best_only": true,
    "plot_training_curves": true,
    "save_confusion_matrix": true,
    "metrics_to_track": [
      "accuracy",
      "loss",
      "learning_rate",
      "gpu_memory",
      "per_class_accuracy"
    ]
  },
  "ensemble": {
    "role": "diversity_provider",
    "weight_in_ensemble": 0.25,
    "complementary_to": ["vit", "yolov8"],
    "specialization": "efficiency_accuracy_balance"
  },
  "breeds": {
    "cattle": [
      "Gir",
      "Sahiwal", 
      "Red_Sindhi",
      "Tharparkar",
      "Rathi",
      "Hariana",
      "Ongole",
      "Krishna_Valley",
      "Deoni",
      "Khillari",
      "Malvi",
      "Nimari",
      "Dangi",
      "Gaolao",
      "Bachaur"
    ],
    "buffalo": [
      "Murrah",
      "Mehsana",
      "Surti",
      "Jaffarabadi",
      "Nili_Ravi",
      "Kundi",
      "Bhadawari",
      "Toda"
    ]
  },
  "transfer_learning": {
    "strategy": "progressive_unfreezing",
    "freeze_stages": [
      {
        "epochs": 3,
        "frozen_layers": ["features"]
      },
      {
        "epochs": 37,
        "frozen_layers": []
      }
    ],
    "learning_rate_schedule": [
      {
        "epochs": 3,
        "backbone_lr": 0,
        "head_lr": 1e-3
      },
      {
        "epochs": 37,
        "backbone_lr": 1e-4,
        "head_lr": 1e-3
      }
    ]
  },
  "regularization": {
    "dropout_rate": 0.2,
    "drop_path_rate": 0.2,
    "label_smoothing": 0.1,
    "weight_decay": 1e-5,
    "gradient_clipping": 1.0,
    "stochastic_depth": 0.1
  },
  "validation": {
    "frequency": 1,
    "metrics": [
      "accuracy",
      "top5_accuracy",
      "precision",
      "recall",
      "f1_score"
    ],
    "save_predictions": true,
    "confusion_matrix": true,
    "per_class_analysis": true
  }
}